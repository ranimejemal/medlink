# Supabase project (Dashboard > Project Settings > API). Use YOUR OWN project.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secrets: never prefix with VITE_, never commit.
SUPABASE_SERVICE_ROLE_KEY=""

# AI request structuring (any OpenAI-compatible API)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Protects cron endpoints (reminders, US-48): generate with `openssl rand -hex 32`
CRON_SECRET=""

# Public address of the site, used in invitation links (e.g. https://medlink.tn). Defaults to the request origin.
SITE_URL=""