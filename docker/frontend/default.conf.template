# MedLink frontend (nginx): the static pages of the app + the single entry point of the site.
#   /                     -> static files (single-page app, falls back to _shell.html)
#   /api/*, /_serverFn/*  -> backend (Node server: server functions, Swagger, health, cron)
#   /auth/v1, /rest/v1, /storage/v1 -> Supabase API gateway
# ${BACKEND_URL} and ${GATEWAY_URL} are filled in when the container starts.
# Behind an HTTPS ingress, keep the original protocol (the server-function CSRF check needs it).
map $http_x_forwarded_proto $medlink_proto { default $http_x_forwarded_proto; "" $scheme; }

# Anti brute force on the auth API itself (OWASP A07), per client IP. The app's own lockout
# (5 failures = 15 min, login_attempts) only covers the login form, which goes through the
# backend; these limits also stop a script calling /auth/v1 directly:
#   - password sign-in (grant_type=password; token refreshes are not limited): 5 per minute;
#   - e-mail codes, sign-up, password reset, MFA code checks: 10 per minute.
# Above the limit (after a short burst): HTTP 429 Too Many Requests.
map $arg_grant_type $medlink_pwlogin_key { password $binary_remote_addr; default ""; }
limit_req_zone $medlink_pwlogin_key zone=pwlogin:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=authcodes:10m rate=10r/m;
limit_req_status 429;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 12m; # patient documents up to 10 MB

  include /etc/nginx/conf.d/security-headers.inc;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host; # with the port: the server-function CSRF check compares it to Origin
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $medlink_proto;
  proxy_set_header Connection "";
  proxy_read_timeout 60s;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # Public settings written at start-up (docker/frontend/40-env-js.sh). Never cached.
  location = /env.js {
    alias /tmp/medlink/env.js;
    default_type application/javascript;
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-store" always;
  }

  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location /api/       { proxy_pass ${BACKEND_URL}; }
  location /_serverFn/ { proxy_pass ${BACKEND_URL}; }

  location /auth/v1/    { proxy_pass ${GATEWAY_URL}; }
  location = /auth/v1/token {
    limit_req zone=pwlogin burst=3 nodelay;
    proxy_pass ${GATEWAY_URL};
  }
  location ~ ^/auth/v1/(verify|otp|signup|recover|resend|factors/[^/]+/verify)$ {
    limit_req zone=authcodes burst=5 nodelay;
    proxy_pass ${GATEWAY_URL};
  }
  location /rest/v1/    { proxy_pass ${GATEWAY_URL}; }
  location /storage/v1/ { proxy_pass ${GATEWAY_URL}; }

  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
    try_files $uri /_shell.html;
  }
}
